DISCORD_TOKEN=seu_token_aqui
OWNER_ID=seu_id_de_usuario_aqui
LICENCA_PEPPER=troque_por_um_valor_aleatorio_grande_so_seu
PORT=3000

# Chave usada pra criptografar as credenciais dos gateways de pagamento
# (access tokens do Mercado Pago etc.) antes de salvar no banco. Gere a
# sua com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA=troque_por_uma_chave_fernet_gerada_so_sua

# URL pública onde ESTE bot está hospedado (a do Render/Discloud, sem
# barra no final). É pra onde os gateways de pagamento automático (ex:
# Mercado Pago) mandam o aviso de "pagamento confirmado". Sem isso, os
# pedidos com gateway automático ainda funcionam, mas dependem de
# `/pedido aprovar` manual porque o webhook não tem endereço de volta.
BASE_URL=https://seu-bot.onrender.com
